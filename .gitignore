node_modules/
dist/
build/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
# The committed templates the real env files are copied from.
!.env.sample
.pnpm-store/

# Written by deploy/deploy.sh on every deploy.
deploy/.deployed-commit
# Written by deploy/edge.sh from deploy/edge/.env, which `.env` above already
# keeps out. Both name one deployment's domains. The .tmp is the render in
# progress.
deploy/edge/Caddyfile
deploy/edge/Caddyfile.tmp

# Terraform's own output, as the pilot repository ignored it at its root, anchored at the folder the
# Terraform now lives in. rendered/ holds each host's manager.env with its generated database password,
# a saved plan holds secret values, and operator.auto.tfvars is an operator's own address for one test
# window. The ** form covers both roots, infra/terraform/ and infra/terraform/vps/.
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/rendered/*
!infra/terraform/rendered/.gitkeep
infra/terraform/**/*.tfplan
infra/terraform/**/tfplan
infra/terraform/**/operator.auto.tfvars
