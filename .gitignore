node_modules/
dist/
build/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
# The committed templates the real env files are copied from.
!.env.sample
.pnpm-store/
# Nx's task cache and the files it writes, kept in the checkout by nx.json's cacheDirectory.
.nx/

# Written by apps/web2-admin/deploy/deploy.sh on every deploy.
apps/web2-admin/deploy/.deployed-commit
# Written by infra/edge/edge.sh from infra/edge/.env, which `.env` above already
# keeps out. Both name one deployment's domains. The .tmp is the render in
# progress.
infra/edge/Caddyfile
infra/edge/Caddyfile.tmp
# The same files at their places before the admin and the edge moved. A checkout made before the
# move still holds them, git leaves ignored files where they are, and the Caddyfile names one
# deployment's domains, so they stay ignored until no such checkout is left.
deploy/.deployed-commit
deploy/edge/Caddyfile
deploy/edge/Caddyfile.tmp

# Terraform's own output, anchored at the folder the Terraform lives in. rendered/ holds each host's
# manager.env with its generated database password, a saved plan holds secret values, and
# operator.auto.tfvars is an operator's own address for one test window. The ** form covers both
# roots, infra/terraform/ and infra/terraform/vps/.
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/rendered/*
!infra/terraform/rendered/.gitkeep
infra/terraform/**/*.tfplan
infra/terraform/**/tfplan
infra/terraform/**/operator.auto.tfvars
