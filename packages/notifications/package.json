{
  "name": "@streaming-monorepo/notifications",
  "version": "0.1.0",
  "private": true,
  "description": "Notices to people over email and Telegram: the notice, the channel to one person's destination, the email provider under the email service, Find my chat's Telegram lookups, and the rules of each service's settings and of a destination.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "compiled": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./rules": {
      "types": "./src/rules.ts",
      "compiled": "./dist/rules.js",
      "default": "./src/rules.ts"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:lib"
    ]
  }
}
