{
  "name": "@streaming-monorepo/web-auth",
  "version": "0.1.0",
  "private": true,
  "description": "The sign-in and session code the backends share: the rules, the tokens, the password hash, the lockout and the cross-site gate.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "compiled": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./rules": {
      "types": "./src/rules.ts",
      "compiled": "./dist/rules.js",
      "default": "./src/rules.ts"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:lib"
    ]
  }
}
