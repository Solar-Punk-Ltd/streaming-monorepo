{
  "name": "@streaming-monorepo/swarm-windows",
  "version": "0.1.0",
  "private": true,
  "description": "The time window convention on Swarm: window numbers and addresses, the live and note payloads, and the writer and reader cores, as pure logic.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "compiled": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "TSX_DISABLE_CACHE=1 tsx --test 'test/*.test.ts'"
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "cafe-utility": "36.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:lib"
    ]
  }
}
