{
  "name": "@streaming-monorepo/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "The shapes the apps send each other: one schema per shape, checked by each side that receives it.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "compiled": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:lib"
    ]
  }
}
