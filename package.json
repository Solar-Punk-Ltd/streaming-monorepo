{
  "name": "streaming-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Solar Punk multi-brand Swarm streaming platform: the Web2 admin layer and the packages around it.",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @streaming-monorepo/web2-admin-backend dev & pnpm --filter @streaming-monorepo/web2-admin-frontend dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.48.1"
  }
}
