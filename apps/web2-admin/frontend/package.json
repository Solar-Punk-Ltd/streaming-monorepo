{
  "name": "@streaming-monorepo/web2-admin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "web2-admin console: React 18 + MUI + Vite, modelled on msrs-client.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "mock-api": "node scripts/mock-api.mjs",
    "build": "pnpm --filter @streaming-monorepo/web2-admin-common build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "11.13.5",
    "@emotion/styled": "11.13.5",
    "@mui/icons-material": "6.1.10",
    "@mui/material": "6.1.10",
    "@mui/x-date-pickers": "7.29.4",
    "@streaming-monorepo/web2-admin-common": "workspace:*",
    "dayjs": "1.11.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "5.6.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "nx": {
    "tags": ["scope:admin", "type:app"]
  }
}
