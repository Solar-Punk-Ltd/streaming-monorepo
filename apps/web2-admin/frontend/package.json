{
  "name": "@streaming-monorepo/web2-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "web2-admin console: React 18 + MUI + Vite, modelled on msrs-client.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "dev": "vite",
    "mock-api": "node scripts/mock-api.mjs",
    "build": "pnpm --filter @streaming-monorepo/web2-admin-common build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/domine": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/x-date-pickers": "9.13.0",
    "@streaming-monorepo/web2-admin-common": "workspace:*",
    "dayjs": "1.11.23",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "nx": {
    "tags": [
      "scope:admin",
      "type:app"
    ]
  }
