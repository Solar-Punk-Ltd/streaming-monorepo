{
  "name": "@streaming-monorepo/web2-admin",
  "private": true,
  "version": "0.1.0",
  "description": "Solar Punk multi-brand Swarm streaming platform: the Web2 admin layer and the packages around it.",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.11.0"
  },
  "scripts": {
    "lint": "pnpm -r --filter './**' --filter '!.' lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "pnpm -r --filter './**' --filter '!.' build",
    "dev": "pnpm --filter @streaming-monorepo/web2-admin-backend dev & pnpm --filter @streaming-monorepo/web2-admin-frontend dev",
    "test": "pnpm -r --filter './**' --filter '!.' test && node --test 'deploy/test/*.test.mjs'",
    "typecheck": "pnpm -r --filter './**' --filter '!.' typecheck"
  },
  "nx": {
    "tags": ["scope:admin", "type:app"],
    "includedScripts": [],
    "targets": {
      "test": {
        "command": "node --test 'deploy/test/*.test.mjs'",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
