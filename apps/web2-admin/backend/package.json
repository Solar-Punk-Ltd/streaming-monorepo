{
  "name": "@streaming-monorepo/web2-admin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "web2-admin API: auth, stream drafts in Postgres, publishing to the Swarm stream list feed, OBS ingest details.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "build": "pnpm --filter @streaming-monorepo/contracts build && pnpm --filter @streaming-monorepo/db-migrate build && pnpm --filter @streaming-monorepo/swarm-windows build && pnpm --filter @streaming-monorepo/web-auth build && pnpm --filter @streaming-monorepo/web2-admin-common build && tsc && rm -rf dist/migrations && cp -r src/migrations dist/migrations",
    "start": "node --conditions=compiled dist/index.js",
    "user:add": "tsx --conditions=development src/cli.ts user:add",
    "dev": "tsx watch --conditions=development src/index.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "tsx --conditions=development --test 'test/unit/**/*.test.ts'",
    "test:integration": "tsx --conditions=development --test 'test/integration/**/*.test.ts'",
    "database:start": "docker compose -p web2-admin -f ./docker-compose.yml up -d postgres",
    "database:stop": "docker compose -p web2-admin -f ./docker-compose.yml stop postgres"
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "@streaming-monorepo/contracts": "workspace:*",
    "@streaming-monorepo/db-migrate": "workspace:*",
    "@streaming-monorepo/swarm-windows": "workspace:*",
    "@streaming-monorepo/web-auth": "workspace:*",
    "@streaming-monorepo/web2-admin-common": "workspace:*",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pg": "8.23.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "nx": {
    "tags": [
      "scope:admin",
      "type:app"
    ]
  }
}
