# The settings the integration suite reads. Copy this file to env.itest in this
# directory, which git ignores, and load it in the shell that runs the suite. The
# sign-in pair, MANAGER_TEST_USERNAME and MANAGER_TEST_PASSWORD, is not kept
# here: put it in that shell's environment from wherever you keep it. Never put
# a password in this file.
MANAGER_URL=http://localhost:9876
MANAGER_TEST_TARGET=http://localhost:9876
# MANAGER_TEST_RUN=nightly1
