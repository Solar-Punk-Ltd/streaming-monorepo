{
  "name": "@streaming-infra-manager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "build": "pnpm --filter @streaming-monorepo/contracts build && pnpm --filter @streaming-infra-manager/common build && tsc && rm -rf dist/migrations && cp -r src/migrations dist/migrations",
    "start": "node --conditions=compiled dist/index.js",
    "database:start": "docker compose -p streaming-infra-manager -f ./docker-compose.yml up -d postgres",
    "database:stop": "docker compose -p streaming-infra-manager -f ./docker-compose.yml stop postgres",
    "stack:start": "docker compose -p streaming-infra-manager -f ./docker-compose.yml --profile full up -d --build",
    "stack:stop": "docker compose -p streaming-infra-manager -f ./docker-compose.yml --profile full down",
    "dev": "tsx watch --conditions=development src/index.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node test/unit/run.mjs",
    "test:database": "node test/database/run-all.mjs",
    "test:native": "tsx --conditions=development --test 'test/native/**/*.test.ts'",
    "test:integration": "tsx --test 'test/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@streaming-infra-manager/common": "workspace:*",
    "dockerode": "5.0.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "pg": "8.23.0",
    "saxes": "6.0.0",
    "viem": "2.56.5",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "nx": {
    "tags": [
      "scope:manager",
      "type:app"
    ]
  }
}
