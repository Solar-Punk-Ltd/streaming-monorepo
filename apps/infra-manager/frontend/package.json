{
  "name": "@streaming-infra-manager/frontend-prototype",
  "version": "0.0.0-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "dev": "vite",
    "dev:mock": "pnpm --filter @streaming-infra-manager/common build && node --import tsx --conditions=development dev/mock-manager.mjs",
    "build": "pnpm --filter @streaming-infra-manager/common build && tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx --conditions=development --test 'src/**/*.test.ts'",
    "test:browser": "node test/run-all.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@streaming-infra-manager/common": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "nx": {
    "tags": [
      "scope:manager",
      "type:app"
    ]
  }
}
