{
  "name": "@swarm-hls-stream/deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deploy and operations scripts, and the tests that drive them against a stubbed docker.",
  "scripts": {
    "lint": "oxlint --type-aware .",
    "test": "node --test test/*.test.js"
  },
  "nx": {
    "tags": [
      "scope:stack",
      "type:app"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          {
            "projects": [
              "@swarm-hls-stream/stream-uploader"
            ],
            "target": "build"
          }
        ]
      }
    }
  }
}
