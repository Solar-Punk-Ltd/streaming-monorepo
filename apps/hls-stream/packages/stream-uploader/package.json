{
  "name": "@swarm-hls-stream/stream-uploader",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/vendor-shared.mjs",
    "start": "node dist/index.js",
    "lint": "oxlint --type-aware .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "TSX_DISABLE_CACHE=1 tsx --test --test-reporter=dot --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=.test-summary.tap test/*.test.ts && node scripts/assert-test-floor.mjs .test-summary.tap"
  },
  "dependencies": {
    "@ethersphere/bee-js": "13.1.0",
    "cafe-utility": "36.3.0",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "p-queue": "9.3.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@swarm-hls-stream/shared": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.4",
    "rimraf": "^6.0.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "nx": {
    "tags": [
      "scope:stack",
      "type:app"
    ]
  }
}
