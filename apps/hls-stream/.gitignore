node_modules
dist
.env*

# Batch id written beside .env when stamp:setup cannot record it there (OPS-1)
stamp-batch-*.txt
!.env.sample
.DS_Store
*.log
coverage
.vscode
state/
nodes/data/
deploy/data/
deploy/config.json
deploy/.env.deploy*
*.tsbuildinfo

# TAP written beside the dot reporter so scripts/assert-test-floor.mjs can count what actually ran
.test-summary.tap

/engines/srs/media

# Compiled output emitted beside sources, which happens when tsc is invoked with
# file names on the command line and so ignores tsconfig.json's outDir.
packages/*/src/**/*.js
packages/*/test/**/*.js

# weeb-3's SharedWorker runtime, copied out of node_modules by the client's `prebuild` so nginx can
# serve it from our own origin. 4 MB of wasm that the lockfile already pins, so the tracked copy
# would only ever be a second version of the same bytes.
packages/client/public/weeb-3/

# Stryker copies the whole tree into a sandbox per run and writes its report beside it.
.stryker-tmp/
reports/mutation/

# Every measurement run's output: raw json, markdown reports, request logs, screenshots and sweep
# logs. The harnesses write to `BENCH_RESULTS_DIR`, which defaults to this folder, and
# `bench-on-host.sh` copies a host's folder back here after every run. Results are a deployment's
# own data and are never tracked.
/bench-results/

# Stryker drains the command runner's stdout slowly, and the uploader suite times out against
# that backpressure. Redirecting it to a file is what makes the dry run pass.
.stryker-test-output.log

# The night's spend authorisation and its dated predecessors. Written when the owner gives it,
# never committed. Lives in the LOCAL repo root: bench-on-host.sh syncs with --delete and no
# exclusion for it, so a copy that exists only on the host is deleted by the next sync.
.spend-ledger.env*

# What each rung was publishing through before drain-stage.sh armed it, one file per profile. It
# carries whole batch ids and it is live state for one deployment, so it belongs beside that
# deployment's env file and nowhere else. The `.env*` rule above does not cover it.
.drain-stage.*.env

# Python bytecode caches, written beside deploy/scripts/*.py by any invocation.
__pycache__/
